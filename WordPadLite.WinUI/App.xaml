            <Style x:Key="StatusBarTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Yu Gothic UI" />
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{ThemeResource MutedInkBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="StatusBarButtonStyle" TargetType="Button" BasedOn="{StaticResource RibbonIconButtonStyle}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="22" />

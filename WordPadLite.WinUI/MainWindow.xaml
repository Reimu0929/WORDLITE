                                                <TextBlock Text="Aa" FontFamily="游明朝" FontSize="16" Foreground="#252423" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border Grid.Row="1" Background="#F7F7F7" CornerRadius="0,0,2,2">
                                                    <TextBlock Text="標準" FontFamily="Yu Gothic UI" FontSize="8.5" Foreground="#252423" HorizontalAlignment="Center" VerticalAlignment="Center" />

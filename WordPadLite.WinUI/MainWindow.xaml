<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WordPadLite.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WordPad Lite">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ChromeBrush}"
        AllowDrop="True"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop">

        <Grid.Resources>
            <Style TargetType="FontIcon">
                <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            </Style>
            <Style TargetType="PathIcon">
                <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="30" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="27" />
        </Grid.RowDefinitions>

        <!-- ============================ TITLE BAR ============================ -->
        <Grid x:Name="TitleBarHost" Grid.Row="0" Background="{StaticResource WordAccentBrush}">
            <Grid x:Name="TitleBarDragSurface" Background="Transparent" />
            <Grid Margin="12,0,148,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="6" Background="White" Margin="0,0,6,0">
                        <TextBlock Text="W" Foreground="{StaticResource WordAccentBrush}" FontFamily="Segoe UI Semibold" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="TitleBarAutoSavePanel" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,3,0">
                        <TextBlock Text="自動保存" FontFamily="Yu Gothic UI" FontSize="11" Foreground="#F0FFFFFF" VerticalAlignment="Center" />
                        <ToggleSwitch
                            x:Name="AutoSaveSwitch"
                            Style="{StaticResource TitleBarToggleSwitchStyle}"
                            Toggled="AutoSaveSwitch_Toggled"
                            ToolTipService.ToolTip="変更を自動的に保存します" />
                    </StackPanel>
                    <StackPanel x:Name="QuickAccessPanel" Orientation="Horizontal" Spacing="1" VerticalAlignment="Center" />
                    <Button x:Name="QuickAccessButton" Style="{StaticResource TitleBarButtonStyle}" Click="RibbonCommand_Click" Tag="qat-more" ToolTipService.ToolTip="クイック アクセス ツール バーのカスタマイズ" Content="&#xE712;" FontSize="11" />
                </StackPanel>

                <StackPanel x:Name="TitleBarTitleHost" Grid.Column="1" Orientation="Horizontal" Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="WindowTitleText" Text="文書 1 - WordPad Lite" FontFamily="Yu Gothic UI" FontSize="13.5" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="540" />
                    <Ellipse x:Name="ModifiedDot" Width="6" Height="6" Fill="White" Visibility="Collapsed" VerticalAlignment="Center" />
                    <TextBlock x:Name="SaveStateText" Text="保存済み" FontFamily="Yu Gothic UI" FontSize="11" Foreground="#D0FFFFFF" VerticalAlignment="Center" Visibility="Collapsed" />
                </StackPanel>

                <Button
                    x:Name="TitleBarAccountButton"
                    Grid.Column="2"
                    Style="{StaticResource TitleBarAvatarButtonStyle}"
                    Click="TitleBarAccount_Click"
                    ToolTipService.ToolTip="アカウント"
                    AutomationProperties.Name="アカウント">
                    <Grid Width="26" Height="26">
                        <Ellipse x:Name="TitleBarAvatarEllipse" Fill="#40FFFFFF" />
                        <FontIcon x:Name="TitleBarAvatarIcon" Glyph="&#xE77B;" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </Grid>
        </Grid>

        <!-- ============================ RIBBON TABS ============================ -->
        <Grid Grid.Row="1" Background="{ThemeResource RibbonBrush}" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="9,0,0,0">
                <ToggleButton x:Name="FileTab" Content="ファイル" Style="{StaticResource FileTabStyle}" Click="RibbonTab_Click" Tag="file" />
                <Border Width="1" Height="18" Background="{ThemeResource HairlineBrush}" Margin="4,0,4,0" VerticalAlignment="Center" />
                <ToggleButton x:Name="HomeTab" Content="ホーム" Style="{StaticResource RibbonTabStyle}" Click="RibbonTab_Click" Tag="home" IsChecked="True" />
                <ToggleButton x:Name="InsertTab" Content="挿入" Style="{StaticResource RibbonTabStyle}" Click="RibbonTab_Click" Tag="insert" />
                <ToggleButton x:Name="DesignTab" Content="デザイン" Style="{StaticResource RibbonTabStyle}" Click="RibbonTab_Click" Tag="design" />
                <ToggleButton x:Name="LayoutTab" Content="レイアウト" Style="{StaticResource RibbonTabStyle}" Click="RibbonTab_Click" Tag="layout" />
                <ToggleButton x:Name="ReferencesTab" Content="参考資料" Style="{StaticResource RibbonTabStyle}" Click="RibbonTab_Click" Tag="references" />
                <ToggleButton x:Name="MailingsTab" Content="差し込み文書" Style="{StaticResource RibbonTabStyle}" Click="RibbonTab_Click" Tag="mailings" />
                <ToggleButton x:Name="ReviewTab" Content="校閲" Style="{StaticResource RibbonTabStyle}" Click="RibbonTab_Click" Tag="review" />
                <ToggleButton x:Name="ViewTab" Content="表示" Style="{StaticResource RibbonTabStyle}" Click="RibbonTab_Click" Tag="view" />
                <ToggleButton x:Name="HelpTab" Content="ヘルプ" Style="{StaticResource RibbonTabStyle}" Click="RibbonTab_Click" Tag="help" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Spacing="3">
                <Button
                    x:Name="DocumentModeButton"
                    Style="{StaticResource RibbonModeButtonStyle}"
                    ToolTipService.ToolTip="文書モードを切り替えます"
                    AutomationProperties.Name="文書モード">
                    <Button.Flyout>
                        <MenuFlyout>
                            <ToggleMenuFlyoutItem x:Name="ModeEditItem" Text="編集" Tag="edit" Click="DocumentModeMenu_Click" />
                            <ToggleMenuFlyoutItem x:Name="ModeReviewItem" Text="校閲" Tag="review" Click="DocumentModeMenu_Click" />
                            <ToggleMenuFlyoutItem x:Name="ModeReadOnlyItem" Text="読み取り専用" Tag="readonly" Click="DocumentModeMenu_Click" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock x:Name="DocumentModeText" Text="編集" FontFamily="Yu Gothic UI" FontSize="11" VerticalAlignment="Center" />
                        <FontIcon Glyph="&#xE70D;" FontSize="8" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Width="1" Height="18" Background="{ThemeResource HairlineBrush}" VerticalAlignment="Center" Margin="2,0,2,0" />
                <Button
                    x:Name="RibbonToggleButton"
                    VerticalAlignment="Center"
                    Width="26"
                    Height="24"
                    FontSize="11"
                    Style="{StaticResource RibbonIconButtonStyle}"
                    Click="RibbonToggle_Click"
                    ToolTipService.ToolTip="リボンを折りたたむ"
                    AutomationProperties.Name="リボンの表示"
                    Content="&#xE70E;" />
            </StackPanel>
        </Grid>

        <!-- ============================ RIBBON ============================ -->
        <Grid x:Name="RibbonHost" Grid.Row="2" Background="{ThemeResource RibbonBrush}">
            <ScrollViewer
                x:Name="RibbonScrollViewer"
                Padding="0,0,0,2"
                HorizontalScrollMode="Enabled"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled"
                VerticalScrollBarVisibility="Disabled"
                IsTabStop="False">
                <Grid x:Name="RibbonPanelHost">
                    <!-- HOME -->
                    <StackPanel x:Name="HomeRibbon" Orientation="Horizontal" Height="92">

                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="15" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource RibbonLargeButtonStyle}" Click="RibbonCommand_Click" Tag="paste" ToolTipService.ToolTip="貼り付け (Ctrl+V)">
                                        <StackPanel Spacing="1">
                                            <FontIcon Glyph="&#xE77F;" FontSize="22" />
                                            <TextBlock Text="貼り付け" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="2,0,0,0" VerticalAlignment="Center">
                                        <Button Style="{StaticResource RibbonSmallTextButtonStyle}" Click="RibbonCommand_Click" Tag="cut" ToolTipService.ToolTip="切り取り (Ctrl+X)">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE8C6;" FontSize="13" />
                                                <TextBlock Text="切り取り" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource RibbonSmallTextButtonStyle}" Click="RibbonCommand_Click" Tag="copy" ToolTipService.ToolTip="コピー (Ctrl+C)">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                                <TextBlock Text="コピー" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource RibbonSmallTextButtonStyle}" Click="RibbonCommand_Click" Tag="format-painter" ToolTipService.ToolTip="書式のコピー">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon Glyph="&#xE790;" FontSize="13" />
                                                <TextBlock Text="書式のコピー" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1" Text="クリップボード" Style="{StaticResource RibbonGroupLabelStyle}" />
                                <Button Grid.Row="1" Style="{StaticResource RibbonGroupLauncherStyle}" Click="RibbonCommand_Click" Tag="clipboard-dialog" ToolTipService.ToolTip="クリップボードの詳細設定" AutomationProperties.Name="クリップボードの詳細設定" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="15" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="152" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="FontCombo" Width="148" Height="26" IsEditable="True" FontFamily="Yu Gothic UI" FontSize="12" VerticalAlignment="Top" SelectionChanged="FontCombo_SelectionChanged" TextSubmitted="FontCombo_TextSubmitted">
                                        <ComboBoxItem Content="游明朝 (本文のフォント)" Tag="游明朝" />
                                        <ComboBoxItem Content="游ゴシック" Tag="游ゴシック" />
                                        <ComboBoxItem Content="MS ゴシック" Tag="MS ゴシック" />
                                        <ComboBoxItem Content="MS 明朝" Tag="MS 明朝" />
                                        <ComboBoxItem Content="メイリオ" Tag="メイリオ" />
                                        <ComboBoxItem Content="BIZ UDPゴシック" Tag="BIZ UDPゴシック" />
                                        <ComboBoxItem Content="Arial" Tag="Arial" />
                                        <ComboBoxItem Content="Calibri" Tag="Calibri" />
                                        <ComboBoxItem Content="Times New Roman" Tag="Times New Roman" />
                                        <ComboBoxItem Content="Courier New" Tag="Courier New" />
                                    </ComboBox>
                                    <ComboBox x:Name="FontSizeCombo" Grid.Column="1" Width="64" Height="26" IsEditable="True" Margin="4,0,0,0" FontFamily="Yu Gothic UI" FontSize="12" VerticalAlignment="Top" SelectionChanged="FontSizeCombo_SelectionChanged" TextSubmitted="FontSizeCombo_TextSubmitted">
                                        <x:String>8</x:String>
                                        <x:String>9</x:String>
                                        <x:String>10</x:String>
                                        <x:String>10.5</x:String>
                                        <x:String>11</x:String>
                                        <x:String>12</x:String>
                                        <x:String>14</x:String>
                                        <x:String>16</x:String>
                                        <x:String>18</x:String>
                                        <x:String>20</x:String>
                                        <x:String>24</x:String>
                                        <x:String>28</x:String>
                                        <x:String>36</x:String>
                                        <x:String>48</x:String>
                                        <x:String>72</x:String>
                                    </ComboBox>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" Margin="4,1,0,0">
                                        <Button Style="{StaticResource RibbonIconButtonStyle}" Click="RibbonCommand_Click" Tag="grow-font" ToolTipService.ToolTip="フォントサイズの拡大" Content="&#xE8E8;" />
                                        <Button Style="{StaticResource RibbonIconButtonStyle}" Click="RibbonCommand_Click" Tag="shrink-font" ToolTipService.ToolTip="フォントサイズの縮小" Content="&#xE8E7;" />
                                        <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTipService.ToolTip="文字種の変換">
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="すべて大文字" Tag="case-upper" Click="RibbonCommand_Click" />
                                                    <MenuFlyoutItem Text="すべて小文字" Tag="case-lower" Click="RibbonCommand_Click" />
                                                    <MenuFlyoutItem Text="各単語の先頭を大文字" Tag="case-title" Click="RibbonCommand_Click" />
                                                    <MenuFlyoutItem Text="大文字と小文字を入れ替え" Tag="case-toggle" Click="RibbonCommand_Click" />
                                                </MenuFlyout>
                                            </Button.Flyout>
                                            <FontIcon Glyph="&#xE8E4;" FontSize="14" />
                                        </Button>
                                        <Button Style="{StaticResource RibbonIconButtonStyle}" Click="RibbonCommand_Click" Tag="clear-format" ToolTipService.ToolTip="すべての書式をクリア" Content="&#xE894;" />
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="0" Margin="0,1,0,0">
                                    <ToggleButton x:Name="BoldToggle" Style="{StaticResource RibbonIconToggleStyle}" FontWeight="Bold" Click="RibbonCommand_Click" Tag="bold" ToolTipService.ToolTip="太字 (Ctrl+B)" Content="&#xE8DD;" />
                                    <ToggleButton x:Name="ItalicToggle" Style="{StaticResource RibbonIconToggleStyle}" Click="RibbonCommand_Click" Tag="italic" ToolTipService.ToolTip="斜体 (Ctrl+I)" Content="&#xE8DB;" />
                                    <ToggleButton x:Name="UnderlineToggle" Style="{StaticResource RibbonIconToggleStyle}" Click="RibbonCommand_Click" Tag="underline" ToolTipService.ToolTip="下線 (Ctrl+U)" Content="&#xE8DC;" />
                                    <Button Style="{StaticResource RibbonChevronButtonStyle}" ToolTipService.ToolTip="下線の種類">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="下線 (下線のみ)" Tag="underline-single" Click="RibbonCommand_Click" />
                                                <MenuFlyoutItem Text="二重下線" Tag="underline-double" Click="RibbonCommand_Click" />
                                                <MenuFlyoutItem Text="点線下線" Tag="underline-dotted" Click="RibbonCommand_Click" />
                                                <MenuFlyoutItem Text="波線下線" Tag="underline-wave" Click="RibbonCommand_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="下線なし" Tag="underline-none" Click="RibbonCommand_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <FontIcon Glyph="&#xE70D;" FontSize="8" />
                                    </Button>
                                    <ToggleButton x:Name="StrikeToggle" Style="{StaticResource RibbonIconToggleStyle}" Click="RibbonCommand_Click" Tag="strike" ToolTipService.ToolTip="取り消し線" Content="&#xEDE0;" />
                                    <Border Width="1" Height="18" Background="{ThemeResource HairlineBrush}" Margin="4,4,4,4" />
                                    <ToggleButton x:Name="SubscriptToggle" Style="{StaticResource RibbonIconToggleStyle}" FontFamily="Yu Gothic UI" Click="RibbonCommand_Click" Tag="subscript" ToolTipService.ToolTip="下付き文字" Content="X₂" FontSize="12" />
                                    <ToggleButton x:Name="SuperscriptToggle" Style="{StaticResource RibbonIconToggleStyle}" FontFamily="Yu Gothic UI" Click="RibbonCommand_Click" Tag="superscript" ToolTipService.ToolTip="上付き文字" Content="X²" FontSize="12" />
                                    <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTipService.ToolTip="フォントの色">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <StackPanel Width="196" Spacing="5">
                                                    <TextBlock Text="フォントの色" FontFamily="Yu Gothic UI" FontSize="12" FontWeight="SemiBold" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#000000" Tag="font-color:#000000" Click="RibbonCommand_Click" ToolTipService.ToolTip="黒" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#1F3864" Tag="font-color:#1F3864" Click="RibbonCommand_Click" ToolTipService.ToolTip="濃い青" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#C00000" Tag="font-color:#C00000" Click="RibbonCommand_Click" ToolTipService.ToolTip="赤" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#375623" Tag="font-color:#375623" Click="RibbonCommand_Click" ToolTipService.ToolTip="濃い緑" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#7030A0" Tag="font-color:#7030A0" Click="RibbonCommand_Click" ToolTipService.ToolTip="紫" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#C55A11" Tag="font-color:#C55A11" Click="RibbonCommand_Click" ToolTipService.ToolTip="オレンジ" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#2F75B5" Tag="font-color:#2F75B5" Click="RibbonCommand_Click" ToolTipService.ToolTip="青" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#7F7F7F" Tag="font-color:#7F7F7F" Click="RibbonCommand_Click" ToolTipService.ToolTip="グレー" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#BFBFBF" Tag="font-color:#BFBFBF" Click="RibbonCommand_Click" ToolTipService.ToolTip="薄いグレー" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFC000" Tag="font-color:#FFC000" Click="RibbonCommand_Click" ToolTipService.ToolTip="黄" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#00B0F0" Tag="font-color:#00B0F0" Click="RibbonCommand_Click" ToolTipService.ToolTip="水色" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFFFFF" Tag="font-color:#FFFFFF" Click="RibbonCommand_Click" ToolTipService.ToolTip="白" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="18" Height="20">
                                            <FontIcon Glyph="&#xE8D3;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                            <Border x:Name="FontColorBar" Height="3" Background="#C00000" CornerRadius="1" VerticalAlignment="Bottom" Margin="1,0,1,0" />
                                        </Grid>
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconButtonStyle}" ToolTipService.ToolTip="蛍光ペン">
                                        <Button.Flyout>
                                            <Flyout Placement="Bottom">
                                                <StackPanel Width="196" Spacing="5">
                                                    <TextBlock Text="蛍光ペン" FontFamily="Yu Gothic UI" FontSize="12" FontWeight="SemiBold" />
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FFF2CC" Tag="highlight:#FFF2CC" Click="RibbonCommand_Click" ToolTipService.ToolTip="黄" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#E2EFDA" Tag="highlight:#E2EFDA" Click="RibbonCommand_Click" ToolTipService.ToolTip="緑" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#DDEBF7" Tag="highlight:#DDEBF7" Click="RibbonCommand_Click" ToolTipService.ToolTip="水色" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FCE4D6" Tag="highlight:#FCE4D6" Click="RibbonCommand_Click" ToolTipService.ToolTip="ピンク" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#E4DFEC" Tag="highlight:#E4DFEC" Click="RibbonCommand_Click" ToolTipService.ToolTip="紫" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="Transparent" Tag="highlight:none" Click="RibbonCommand_Click" ToolTipService.ToolTip="なし">
                                                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                        <Grid Width="18" Height="20">
                                            <FontIcon Glyph="&#xE7E6;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                            <Border x:Name="HighlightColorBar" Height="3" Background="#FFC000" CornerRadius="1" VerticalAlignment="Bottom" Margin="1,0,1,0" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="2" Text="フォント" Style="{StaticResource RibbonGroupLabelStyle}" />
                                <Button Grid.Row="2" Style="{StaticResource RibbonGroupLauncherStyle}" Click="RibbonCommand_Click" Tag="font-dialog" ToolTipService.ToolTip="フォントの詳細設定" AutomationProperties.Name="フォントの詳細設定" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RibbonGroupStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="15" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="0">
                                    <ToggleButton x:Name="BulletsToggle" Style="{StaticResource RibbonIconToggleStyle}" Click="RibbonCommand_Click" Tag="bullets" ToolTipService.ToolTip="箇条書き" Content="&#xE8FD;" />
                                    <Button Style="{StaticResource RibbonChevronButtonStyle}" ToolTipService.ToolTip="箇条書きの種類">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="• 箇条書き" Tag="bullets" Click="RibbonCommand_Click" />
                                                <MenuFlyoutItem Text="◦ 白丸" Tag="bullets-white" Click="RibbonCommand_Click" />
                                                <MenuFlyoutItem Text="■ 四角" Tag="bullets-square" Click="RibbonCommand_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="なし" Tag="list-none" Click="RibbonCommand_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <FontIcon Glyph="&#xE70D;" FontSize="8" />
                                    </Button>
                                    <ToggleButton x:Name="NumberingToggle" Style="{StaticResource RibbonIconToggleStyle}" Click="RibbonCommand_Click" Tag="numbering" ToolTipService.ToolTip="段落番号">
                                        <Grid Width="17" Height="17">
                                            <TextBlock Text="1" FontFamily="Segoe UI" FontSize="7.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-1,0,0" />
                                            <Path Data="M7,2 H16 M7,8 H16 M7,14 H16" Width="10" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.25" Stretch="Uniform" />
                                        </Grid>
                                    </ToggleButton>
                                    <Button Style="{StaticResource RibbonChevronButtonStyle}" ToolTipService.ToolTip="番号付けの種類">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="1. 2. 3." Tag="numbering" Click="RibbonCommand_Click" />
                                                <MenuFlyoutItem Text="A. B. C." Tag="numbering-alpha" Click="RibbonCommand_Click" />
                                                <MenuFlyoutItem Text="a. b. c." Tag="numbering-alpha-lower" Click="RibbonCommand_Click" />
                                                <MenuFlyoutItem Text="i. ii. iii." Tag="numbering-roman" Click="RibbonCommand_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="なし" Tag="list-none" Click="RibbonCommand_Click" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <FontIcon Glyph="&#xE70D;" FontSize="8" />
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconButtonStyle}" Click="RibbonCommand_Click" Tag="multilevel" ToolTipService.ToolTip="アウトライン">
                                        <Grid Width="17" Height="17">
                                            <TextBlock Text="1" FontFamily="Segoe UI" FontSize="7" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <Path Data="M6,2 H16 M9,8 H16 M9,14 H16" Width="11" Height="16" HorizontalAlignment="Right" VerticalAlignment="Center" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.25" Stretch="Uniform" />
                                        </Grid>
                                    </Button>
                                    <Border Width="1" Height="16" Background="{ThemeResource HairlineBrush}" Margin="4,5,4,5" />
                                    <Button Style="{StaticResource RibbonIconButtonStyle}" Click="RibbonCommand_Click" Tag="indent-decrease" ToolTipService.ToolTip="インデントを減らす">

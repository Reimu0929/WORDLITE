                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="標準" Tag="style:normal" Click="RibbonCommand_Click" />
                                                <MenuFlyoutItem Text="行間詰め" Tag="style:nospacing" Click="RibbonCommand_Click" />

                                            </MenuFlyout>
                                        </Button.Flyout>
                                        <FontIcon Glyph="&#xE70D;" FontSize="9" />
                                    </Button>
                                </StackPanel>
                                <TextBlock Grid.Row="1" Text="スタイル" Style="{StaticResource RibbonGroupLabelStyle}" />
                                <Button Grid.Row="1" Style="{StaticResource RibbonGroupLauncherStyle}" Click="RibbonCommand_Click" Tag="styles-dialog" ToolTipService.ToolTip="スタイルの詳細設定" AutomationProperties.Name="スタイルの詳細設定" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RibbonGroupStyle}" BorderThickness="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="15" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="1">
                                    <Button Style="{StaticResource RibbonLargeButtonStyle}" Width="57" Click="RibbonCommand_Click" Tag="find" ToolTipService.ToolTip="検索 (Ctrl+F)">
                                        <StackPanel Spacing="1">
                                            <FontIcon Glyph="&#xE721;" FontSize="24" />
                                            <TextBlock Text="検索" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource RibbonLargeButtonStyle}" Width="57" Click="RibbonCommand_Click" Tag="replace" ToolTipService.ToolTip="置換 (Ctrl+H)">

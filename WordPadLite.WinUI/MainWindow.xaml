                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#E2EFDA" Tag="shading:#E2EFDA" Click="RibbonCommand_Click" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#DDEBF7" Tag="shading:#DDEBF7" Click="RibbonCommand_Click" />
                                                        <Button Style="{StaticResource ColorSwatchButtonStyle}" Background="#FCE4D6" Tag="shading:#FCE4D6" Click="RibbonCommand_Click" />

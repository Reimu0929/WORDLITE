                                        <Path Data="M2,2 V16 M6,2 H10 M6,8 H10 M6,14 H10 M14,2 V16" Width="16" Height="16" Stroke="{ThemeResource InkBrush}" StrokeThickness="1.25" Stretch="Uniform" />
                                    </Button>
                                    <Button Style="{StaticResource RibbonIconButtonStyle}" Click="RibbonCommand_Click" Tag="text-effects" ToolTipService.ToolTip="拡張書式" Content="&#xE8D2;" />

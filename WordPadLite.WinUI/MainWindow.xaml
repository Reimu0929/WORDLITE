                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button x:Name="StyleNoSpacingButton" Style="{StaticResource StyleGalleryButtonStyle}" Width="82" Click="RibbonCommand_Click" Tag="style:nospacing" ToolTipService.ToolTip="行間詰め">

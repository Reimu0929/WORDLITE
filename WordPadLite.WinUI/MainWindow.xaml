                                        <Border Background="White" BorderBrush="{ThemeResource HairlineBrush}" BorderThickness="1" CornerRadius="2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="14" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Aa" FontFamily="游明朝" FontSize="16" FontWeight="Bold" Foreground="{StaticResource WordAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Border Grid.Row="1" Background="#F7F7F7" CornerRadius="0,0,2,2">
                                                    <TextBlock Text="見出し 1" FontFamily="Yu Gothic UI" FontSize="8.5" Foreground="#252423" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Button>
                                    <Button x:Name="StyleMoreButton" Style="{StaticResource StyleGalleryMoreButtonStyle}" ToolTipService.ToolTip="その他のスタイル">
